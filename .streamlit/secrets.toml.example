# ============================================================
# 配置模板 —— 复制为 secrets.toml 后填写真实值
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml 已被 .gitignore 排除，不会进代码库；
# 本模板相反，是要提交上去给别人看的。
# 部署到 Streamlit Cloud 时，把下面同样的内容填到：
#   App → Settings → Secrets
# ============================================================

# ---- 访问口令 ----
# 公网部署务必设置；留空则任何人都能访问
APP_PASSWORD = "在这里填你的口令"
APP_PASSWORD_HINT = "显示在登录页的提示语（不要直接写出口令本身）"

# ---- 大模型配置 ----
# 留空则自动进入离线演示模式（客户走内置脚本，断网也能跑完整流程）
LLM_API_KEY = "sk-xxxxxxxxxxxxxxxx"
LLM_BASE_URL = "https://api.deepseek.com/v1"
LLM_MODEL = "deepseek-chat"

# 想换中国移动的模型，只改这两行（其余不用动）：
#   LLM_BASE_URL = "https://<你们的网关地址>/v1"
#   LLM_MODEL    = "<模型名>"
